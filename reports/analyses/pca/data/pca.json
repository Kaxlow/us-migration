  "interpretations": [
    {
      "component": "PC1",
      "title": "Income, education and housing costs",
      "variance_ratio": 0.34210317544363994,
      "positive": "Log income (+0.899), Log home value (+0.882), Log rent (+0.873)",
      "negative": "Poverty % (-0.679), Vacancy % (-0.500), Unemployment % (-0.312)",
      "interpretation": "Higher scores describe counties with higher incomes, home values, rents and educational attainment, often with larger populations and less poverty. In everyday terms, this is an affluence and housing-cost dimension. Lower scores describe lower incomes, housing costs and educational attainment, with more poverty.",
      "features": "Log income (+0.899), Log home value (+0.882), Log rent (+0.873)"
    },
    {
      "component": "PC2",
      "title": "Older, owner-occupied communities in cooler climates",
      "variance_ratio": 0.20322547638972588,
      "positive": "Homeownership % (+0.732), Median age (+0.594), Vacancy % (+0.350)",
      "negative": "Temperature (-0.589), Poverty % (-0.581), Unemployment % (-0.563)",
      "interpretation": "Higher scores describe older populations and more homeownership, alongside cooler temperatures, smaller populations, less poverty and less unemployment. This combines settled household patterns with climate and economic differences. Lower scores describe younger populations, less homeownership and warmer climates, with larger populations and more poverty and unemployment.",
      "features": "Homeownership % (+0.732), Median age (+0.594), Temperature (-0.589)"
    },
    {
      "component": "PC3",
      "title": "Wetter, older communities with more recorded incidents",
      "variance_ratio": 0.11320738459371794,
      "positive": "Precipitation (+0.662), Median age (+0.601), Log1p incidents (+0.438)",
      "negative": "Poverty % (-0.040)",
      "interpretation": "Higher scores describe wetter counties with older populations and more FEMA-recorded incidents, alongside more housing vacancy. This is a combined age, rainfall and incident-history dimension. Lower scores describe drier counties, younger populations and fewer recorded incidents, with less housing vacancy.",
      "features": "Precipitation (+0.662), Median age (+0.601), Log1p incidents (+0.438)"
    },
    {
      "component": "PC4",
      "title": "Housing vacancy and unemployment in cooler climates",
      "variance_ratio": 0.078215190610489,
      "positive": "Vacancy % (+0.492), Unemployment % (+0.436), Bachelor\u2019s+ % (+0.277)",
      "negative": "Temperature (-0.439), Homeownership % (-0.314), Precipitation (-0.287)",
      "interpretation": "Higher scores describe more vacant housing and unemployment, together with cooler temperatures and less homeownership. This captures a housing and labor-market contrast with a climate element. Lower scores describe less vacancy and unemployment, warmer temperatures and more homeownership.",
      "features": "Vacancy % (+0.492), Temperature (-0.439), Unemployment % (+0.436)"
    },
    {
      "component": "PC5",
      "title": "Recorded disaster-incident history",
      "variance_ratio": 0.07008784003260178,
      "positive": "Log1p incidents (+0.871), Poverty % (+0.013)",
      "negative": "Temperature (-0.225), Unemployment % (-0.167), Precipitation (-0.155)",
      "interpretation": "Higher scores chiefly describe more distinct FEMA-recorded incidents; cooler temperatures and lower unemployment have much smaller contributions. This largely isolates incident history after the earlier components capture other shared patterns. Lower scores chiefly describe fewer recorded incidents; temperature and unemployment provide weaker contrasts.",
      "features": "Log1p incidents (+0.871), Temperature (-0.225), Unemployment % (-0.167)"
    }
